with "config/adda_2048_config.gpr";
project Adda_2048 is

   for Source_Dirs use ("src/**", "config/");
   for Object_Dir use "obj/" & Adda_2048_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("main.adb");

   package Builder is
      for Executable ("main.adb") use "adda_2048";
   end Builder;

   package Compiler is
      --  TODO: Add stricter compiler switches when ready:
      --    "-gnatwa"  (all warnings enabled)
      --    "-gnatwe"  (warnings as errors)
      --    "-gnata"   (assertions enabled)
      --    "-gnatVa"  (all validity checks)
      --    "-gnatyg"  (GNAT style checks)
      --    "-gnatQ"   (don't quit on errors, find more)
      for Default_Switches ("Ada") use
        Adda_2048_Config.Ada_Compiler_Switches & ("-gnatX");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Prove is
      for Proof_Dir use "proof";
      --  TODO: Increase rigor when ready:
      --    "--level=4"          (maximum rigor, currently 2)
      --    "--warnings=error"   (treat warnings as errors)
      --    "--checks-as-errors" (failed checks = failure)
      for Switches use ("--mode=prove",
                        "--level=2",
                        "--prover=all",
                        "--timeout=60");
   end Prove;

   --  TODO: Add Check package for coding standard enforcement
   --  package Check is
   --     for Default_Switches ("Ada") use ("-rules", "-from=gnatcheck.rules");
   --  end Check;

   --  TODO: Add Pretty_Printer package for consistent formatting
   --  package Pretty_Printer is
   --     for Default_Switches ("Ada") use
   --       ("-i3", "-M120", "--no-separate-is");
   --  end Pretty_Printer;

   --  TODO: Add Documentation package and create docs/ directory
   --  package Documentation is
   --     for Documentation_Dir use "docs";
   --  end Documentation;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Adda_2048;
