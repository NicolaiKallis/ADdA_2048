with "config/adda_2048_config.gpr";
project Adda_2048 is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Adda_2048_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("main.adb");

   package Builder is
      for Executable ("main.adb") use "adda_2048";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use Adda_2048_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Adda_2048;
